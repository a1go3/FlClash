diff --git a/component/tls/fragment.go b/component/tls/fragment.go
new file mode 100644
index 0000000..e908a6c
--- /dev/null
+++ b/component/tls/fragment.go
@@ -0,0 +1,176 @@
+package tls
+
+import (
+	"encoding/binary"
+	"fmt"
+	"net"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	"github.com/metacubex/mihomo/common/buf"
+	N "github.com/metacubex/mihomo/common/net"
+
+	"github.com/metacubex/randv2"
+)
+
+const (
+	recordTypeHandshake = 0x16
+	recordHeaderLen     = 5
+)
+
+// FragmentConfig spreads the first handshake record a client writes, the
+// ClientHello, over several TLS records. A filter that classifies a connection
+// by its first record no longer sees a whole hello, while servers reassemble
+// handshake messages across records as RFC 8446 section 5.1 requires.
+type FragmentConfig struct {
+	MinLength int
+	MaxLength int
+	// Zero hands every record to one Write; otherwise each record is written
+	// on its own, this far apart.
+	MinInterval time.Duration
+	MaxInterval time.Duration
+}
+
+func ParseFragmentConfig(packets, length, interval string) (*FragmentConfig, error) {
+	if packets != "" && packets != "tlshello" {
+		return nil, fmt.Errorf("tls-fragment: unsupported packets %q, only tlshello", packets)
+	}
+	minLength, maxLength, err := parseFragmentRange(length, "100-200")
+	if err != nil {
+		return nil, fmt.Errorf("tls-fragment: length: %w", err)
+	}
+	if minLength < 1 || maxLength > 1<<14 {
+		return nil, fmt.Errorf("tls-fragment: length %q is outside 1-16384", length)
+	}
+	minInterval, maxInterval, err := parseFragmentRange(interval, "1")
+	if err != nil {
+		return nil, fmt.Errorf("tls-fragment: interval: %w", err)
+	}
+	return &FragmentConfig{
+		MinLength:   minLength,
+		MaxLength:   maxLength,
+		MinInterval: time.Duration(minInterval) * time.Millisecond,
+		MaxInterval: time.Duration(maxInterval) * time.Millisecond,
+	}, nil
+}
+
+func parseFragmentRange(value, fallback string) (int, int, error) {
+	value = strings.TrimSpace(value)
+	if value == "" {
+		value = fallback
+	}
+	low, high, isRange := strings.Cut(value, "-")
+	minValue, err := strconv.Atoi(strings.TrimSpace(low))
+	if err != nil {
+		return 0, 0, err
+	}
+	maxValue := minValue
+	if isRange {
+		maxValue, err = strconv.Atoi(strings.TrimSpace(high))
+		if err != nil {
+			return 0, 0, err
+		}
+	}
+	if minValue < 0 || maxValue < minValue {
+		return 0, 0, fmt.Errorf("invalid range %q", value)
+	}
+	return minValue, maxValue, nil
+}
+
+func randomIn(minValue, maxValue int) int {
+	return minValue + randv2.IntN(maxValue-minValue+1)
+}
+
+type fragmentConn struct {
+	N.ExtendedConn
+	config  *FragmentConfig
+	written atomic.Bool
+}
+
+func NewFragmentConn(conn net.Conn, config *FragmentConfig) net.Conn {
+	return &fragmentConn{ExtendedConn: N.NewExtendedConn(conn), config: config}
+}
+
+func (c *fragmentConn) Write(b []byte) (int, error) {
+	if c.written.Swap(true) {
+		return c.ExtendedConn.Write(b)
+	}
+	records, rest, ok := splitHandshakeRecord(b, c.config.MinLength, c.config.MaxLength)
+	if !ok {
+		return c.ExtendedConn.Write(b)
+	}
+	if c.config.MaxInterval <= 0 {
+		joined := make([]byte, 0, len(b)+len(records)*recordHeaderLen)
+		for _, record := range records {
+			joined = append(joined, record...)
+		}
+		if _, err := c.ExtendedConn.Write(append(joined, rest...)); err != nil {
+			return 0, err
+		}
+		return len(b), nil
+	}
+	for i, record := range records {
+		if i > 0 {
+			time.Sleep(time.Duration(randomIn(int(c.config.MinInterval), int(c.config.MaxInterval))))
+		}
+		if _, err := c.ExtendedConn.Write(record); err != nil {
+			return 0, err
+		}
+	}
+	if len(rest) > 0 {
+		if _, err := c.ExtendedConn.Write(rest); err != nil {
+			return 0, err
+		}
+	}
+	return len(b), nil
+}
+
+func (c *fragmentConn) WriteBuffer(buffer *buf.Buffer) error {
+	if c.written.Load() {
+		return c.ExtendedConn.WriteBuffer(buffer)
+	}
+	defer buffer.Release()
+	_, err := c.Write(buffer.Bytes())
+	return err
+}
+
+func (c *fragmentConn) Upstream() any {
+	return c.ExtendedConn
+}
+
+func (c *fragmentConn) ReaderReplaceable() bool {
+	return true
+}
+
+func (c *fragmentConn) WriterReplaceable() bool {
+	return c.written.Load()
+}
+
+// splitHandshakeRecord re-frames the handshake record at the start of b; the
+// handshake bytes stay as they are, so the transcript hash and the REALITY
+// session ID sealed over the hello are unaffected.
+func splitHandshakeRecord(b []byte, minLength, maxLength int) (records [][]byte, rest []byte, ok bool) {
+	if len(b) < recordHeaderLen || b[0] != recordTypeHandshake {
+		return nil, nil, false
+	}
+	bodyLen := int(binary.BigEndian.Uint16(b[3:recordHeaderLen]))
+	if len(b) < recordHeaderLen+bodyLen {
+		return nil, nil, false
+	}
+	body := b[recordHeaderLen : recordHeaderLen+bodyLen]
+	for len(body) > 0 {
+		size := randomIn(minLength, maxLength)
+		if size > len(body) {
+			size = len(body)
+		}
+		record := make([]byte, recordHeaderLen+size)
+		copy(record, b[:3])
+		binary.BigEndian.PutUint16(record[3:recordHeaderLen], uint16(size))
+		copy(record[recordHeaderLen:], body[:size])
+		records = append(records, record)
+		body = body[size:]
+	}
+	return records, b[recordHeaderLen+bodyLen:], true
+}
diff --git a/component/tls/fragment_test.go b/component/tls/fragment_test.go
new file mode 100644
index 0000000..fc3fc91
--- /dev/null
+++ b/component/tls/fragment_test.go
@@ -0,0 +1,138 @@
+package tls
+
+import (
+	"bytes"
+	"encoding/binary"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+type recordingConn struct {
+	net.Conn
+	writes [][]byte
+}
+
+func (c *recordingConn) Write(b []byte) (int, error) {
+	c.writes = append(c.writes, append([]byte(nil), b...))
+	return len(b), nil
+}
+
+func clientHelloRecord(bodyLen int) []byte {
+	record := make([]byte, recordHeaderLen+bodyLen)
+	record[0] = recordTypeHandshake
+	record[1], record[2] = 0x03, 0x01
+	binary.BigEndian.PutUint16(record[3:recordHeaderLen], uint16(bodyLen))
+	for i := range record[recordHeaderLen:] {
+		record[recordHeaderLen+i] = byte(i)
+	}
+	return record
+}
+
+func parseRecords(t *testing.T, stream []byte) (lengths []int, body []byte) {
+	for len(stream) > 0 {
+		require.GreaterOrEqual(t, len(stream), recordHeaderLen)
+		assert.Equal(t, []byte{recordTypeHandshake, 0x03, 0x01}, stream[:3])
+		size := int(binary.BigEndian.Uint16(stream[3:recordHeaderLen]))
+		lengths = append(lengths, size)
+		body = append(body, stream[recordHeaderLen:recordHeaderLen+size]...)
+		stream = stream[recordHeaderLen+size:]
+	}
+	return lengths, body
+}
+
+func TestFragmentSplitsTheClientHelloIntoRecordsInRange(t *testing.T) {
+	inner := &recordingConn{}
+	conn := NewFragmentConn(inner, &FragmentConfig{MinLength: 100, MaxLength: 200})
+	hello := clientHelloRecord(1531)
+
+	n, err := conn.Write(hello)
+	require.NoError(t, err)
+	assert.Equal(t, len(hello), n)
+	require.Len(t, inner.writes, 1)
+
+	lengths, body := parseRecords(t, inner.writes[0])
+	assert.Equal(t, hello[recordHeaderLen:], body)
+	assert.GreaterOrEqual(t, len(lengths), 8)
+	for _, size := range lengths[:len(lengths)-1] {
+		assert.GreaterOrEqual(t, size, 100)
+		assert.LessOrEqual(t, size, 200)
+	}
+}
+
+func TestFragmentWritesEachRecordApartWithAnInterval(t *testing.T) {
+	inner := &recordingConn{}
+	conn := NewFragmentConn(inner, &FragmentConfig{
+		MinLength:   150,
+		MaxLength:   150,
+		MinInterval: time.Millisecond,
+		MaxInterval: time.Millisecond,
+	})
+	hello := clientHelloRecord(400)
+
+	_, err := conn.Write(append(hello, 0x14, 0x03, 0x03))
+	require.NoError(t, err)
+
+	require.Len(t, inner.writes, 4)
+	lengths, _ := parseRecords(t, bytes.Join(inner.writes[:3], nil))
+	assert.Equal(t, []int{150, 150, 100}, lengths)
+	assert.Equal(t, []byte{0x14, 0x03, 0x03}, inner.writes[3])
+}
+
+func TestFragmentLeavesLaterWritesAlone(t *testing.T) {
+	inner := &recordingConn{}
+	conn := NewFragmentConn(inner, &FragmentConfig{MinLength: 100, MaxLength: 200})
+	_, err := conn.Write(clientHelloRecord(300))
+	require.NoError(t, err)
+
+	second := clientHelloRecord(300)
+	_, err = conn.Write(second)
+	require.NoError(t, err)
+
+	assert.Equal(t, second, inner.writes[len(inner.writes)-1])
+}
+
+func TestFragmentLeavesAFirstWriteThatIsNoWholeHandshakeAlone(t *testing.T) {
+	for name, first := range map[string][]byte{
+		"application data": {0x17, 0x03, 0x03, 0x00, 0x01, 0x00},
+		"truncated record": clientHelloRecord(300)[:200],
+	} {
+		t.Run(name, func(t *testing.T) {
+			inner := &recordingConn{}
+			conn := NewFragmentConn(inner, &FragmentConfig{MinLength: 100, MaxLength: 200})
+
+			_, err := conn.Write(first)
+			require.NoError(t, err)
+
+			assert.Equal(t, [][]byte{first}, inner.writes)
+		})
+	}
+}
+
+func TestParseFragmentConfig(t *testing.T) {
+	config, err := ParseFragmentConfig("", "", "")
+	require.NoError(t, err)
+	assert.Equal(t, &FragmentConfig{
+		MinLength:   100,
+		MaxLength:   200,
+		MinInterval: time.Millisecond,
+		MaxInterval: time.Millisecond,
+	}, config)
+
+	config, err = ParseFragmentConfig("tlshello", "50-80", "0")
+	require.NoError(t, err)
+	assert.Equal(t, &FragmentConfig{MinLength: 50, MaxLength: 80}, config)
+
+	for _, args := range [][3]string{
+		{"1-3", "", ""},
+		{"", "200-100", ""},
+		{"", "0", ""},
+		{"", "", "fast"},
+	} {
+		_, err := ParseFragmentConfig(args[0], args[1], args[2])
+		assert.Error(t, err, args)
+	}
+}
