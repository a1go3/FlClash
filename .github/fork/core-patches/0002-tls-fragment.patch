+// REALITY profiles split the ClientHello unless they say otherwise: provider
+// filters freeze a server port on a whole hello in the first record, and
+// subscriptions carry no fragment settings.
+func (o *TLSFragmentOptions) Parse(isReality bool) (*tlsC.FragmentConfig, error) {
+	if o == nil {
+		if !isReality {
+			return nil, nil
+		}
+		return tlsC.ParseFragmentConfig("", "", "")
+	}
+	if o.Enable != nil && !*o.Enable {
+		return nil, nil
+	}
+	return tlsC.ParseFragmentConfig(o.Packets, o.Length, o.Interval)
 }
 
