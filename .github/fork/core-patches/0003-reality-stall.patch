@@ -376,7 +380,13 @@ func (v *Vless) dialContext(ctx context.Context) (c net.Conn, err error) {
 	case "grpc": // gun transport
 		return v.gunClient.Dial()
 	case "xhttp":
-		return v.xhttpClient.Dial(ctx)
+		c, err = v.xhttpClient.Dial(ctx)
+		// Streams ride on connections the transport dials apart from them, so a
+		// dial out of time while a handshake still waits for the server is a stall.
+		if err != nil && ctx.Err() != nil && v.pendingHandshakes.Load() > 0 {
+			err = &tlsC.HandshakeStallError{Err: err}
+		}
+		return c, err
 	default:
 	}
 	return v.dialer.DialContext(ctx, "tcp", v.addr)
