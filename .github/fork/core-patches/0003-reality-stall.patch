+++ b/component/tls/reality.go
@@ -117,6 +117,10 @@ func GetRealityConn(ctx context.Context, conn net.Conn, fingerprint UClientHello
 
 		err = uConn.HandshakeContext(ctx)
 		if err != nil {
+			if isHandshakeStall(ctx, err) {
+				log.Warnln("[REALITY] %s: no answer to the ClientHello after the TCP connect: %v", conn.RemoteAddr(), err)
+				return nil, &HandshakeStallError{Err: err}
+			}
 			return nil, err
 		}
 
diff --git a/component/tls/stall.go b/component/tls/stall.go
new file mode 100644
index 0000000..2463583
--- /dev/null
+++ b/component/tls/stall.go
@@ -0,0 +1,36 @@
+package tls
+
+import (
+	"context"
+	"errors"
+	"net"
+)
+
+// HandshakeStallError is a TLS handshake whose TCP connection came up but
+// whose ClientHello got no answer in time, which is how a provider filter
+// freezing a server address and port looks from the client.
+type HandshakeStallError struct {
+	Err error
+}
+
+func (e *HandshakeStallError) Error() string {
+	return "TLS handshake stalled after the ClientHello: " + e.Err.Error()
+}
+
+func (e *HandshakeStallError) Unwrap() error {
+	return e.Err
+}
+
+// HandshakeStalled lets callers outside this module recognise the error with
+// errors.As on an interface, without importing the type.
+func (e *HandshakeStallError) HandshakeStalled() bool {
+	return true
+}
+
+func isHandshakeStall(ctx context.Context, err error) bool {
+	if ctx.Err() != nil {
+		return true
+	}
+	var netErr net.Error
+	return errors.As(err, &netErr) && netErr.Timeout()
+}
diff --git a/component/tls/stall_test.go b/component/tls/stall_test.go
new file mode 100644
index 0000000..b020deb
--- /dev/null
+++ b/component/tls/stall_test.go
@@ -0,0 +1,79 @@
+package tls
+
+import (
+	"context"
+	"crypto/ecdh"
+	"crypto/rand"
+	"errors"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestRealityHandshakeWithoutAnswerIsAStall(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer listener.Close()
+	go func() {
+		conn, err := listener.Accept()
+		if err != nil {
+			return
+		}
+		defer conn.Close()
+		_, _ = conn.Read(make([]byte, 4096))
+		time.Sleep(time.Second)
+	}()
+
+	conn, err := net.Dial("tcp", listener.Addr().String())
+	require.NoError(t, err)
+	defer conn.Close()
+	key, err := ecdh.X25519().GenerateKey(rand.Reader)
+	require.NoError(t, err)
+	fingerprint, ok := GetFingerprint("safari")
+	require.True(t, ok)
+
+	ctx, cancel := context.WithTimeout(context.Background(), 200*time.Millisecond)
+	defer cancel()
+	_, err = GetRealityConn(ctx, conn, fingerprint, "www.example.com", &RealityConfig{
+		PublicKey:             key.PublicKey(),
+		SupportX25519MLKEM768: true,
+	})
+
+	var stall interface{ HandshakeStalled() bool }
+	require.True(t, errors.As(err, &stall), "got %v", err)
+}
+
+func TestRealityHandshakeRefusedByTheServerIsNoStall(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer listener.Close()
+	go func() {
+		conn, err := listener.Accept()
+		if err != nil {
+			return
+		}
+		_, _ = conn.Read(make([]byte, 4096))
+		conn.Close()
+	}()
+
+	conn, err := net.Dial("tcp", listener.Addr().String())
+	require.NoError(t, err)
+	defer conn.Close()
+	key, err := ecdh.X25519().GenerateKey(rand.Reader)
+	require.NoError(t, err)
+	fingerprint, ok := GetFingerprint("safari")
+	require.True(t, ok)
+
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	_, err = GetRealityConn(ctx, conn, fingerprint, "www.example.com", &RealityConfig{
+		PublicKey:             key.PublicKey(),
+		SupportX25519MLKEM768: true,
+	})
+
+	require.Error(t, err)
+	var stall interface{ HandshakeStalled() bool }
+	require.False(t, errors.As(err, &stall), "got %v", err)
+}
