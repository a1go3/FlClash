@@ -54,6 +55,9 @@ type Vless struct {
 	jlsConfig       *jls.Config
 	realityConfig   *tlsC.RealityConfig
 	fragmentConfig  *tlsC.FragmentConfig
+
+	// for xhttp: TLS handshakes still waiting for the server's answer
+	pendingHandshakes atomic.Int32
 }
 
