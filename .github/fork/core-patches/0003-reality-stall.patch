-		return nil, fmt.Errorf("%s connect error: %s", v.addr, err.Error())
+		return nil, fmt.Errorf("%s connect error: %w", v.addr, err)
 	}
 	defer func(c net.Conn) {
 		safeConnClose(c, err)
@@ -415,7 +425,7 @@ func (v *Vless) ListenPacketContext(ctx context.Context, metadata *C.Metadata) (
 
 	c, err = v.StreamConnContext(ctx, c, metadata)
 	if err != nil {
-		return nil, fmt.Errorf("%s connect error: %s", v.addr, err.Error())
+		return nil, fmt.Errorf("%s connect error: %w", v.addr, err)
 	}
 
 	if v.option.XUDP {
@@ -604,7 +614,7 @@ func NewVless(option VlessOption) (*Vless, error) {
 		dialFn := func(ctx context.Context, network, addr string) (net.Conn, error) {
 			c, err := v.dialer.DialContext(ctx, "tcp", v.addr)
 			if err != nil {
-				return nil, fmt.Errorf("%s connect error: %s", v.addr, err.Error())
+				return nil, fmt.Errorf("%s connect error: %w", v.addr, err)
 			}
 			return c, nil
 		}
@@ -710,6 +720,12 @@ func NewVless(option VlessOption) (*Vless, error) {
 					return v.dialer.DialContext(ctx, "tcp", v.addr)
 				},
 				func(ctx context.Context, raw net.Conn, isH2 bool) (net.Conn, error) {
+					// The transport's dial need not carry a request's deadline, and a
+					// ClientHello nobody answers would otherwise wait for good.
+					ctx, cancel := context.WithTimeout(ctx, C.DefaultTLSTimeout)
+					defer cancel()
+					v.pendingHandshakes.Add(1)
+					defer v.pendingHandshakes.Add(-1)
 					return v.streamTLSConn(ctx, raw, isH2)
 				},
 				func(ctx context.Context, cfg *quic.Config) (*quic.Conn, error) {
diff --git a/adapter/reality_stall_test.go b/adapter/reality_stall_test.go
new file mode 100644
index 0000000..2725569
--- /dev/null
+++ b/adapter/reality_stall_test.go
@@ -0,0 +1,79 @@
+package adapter_test
+
+import (
+	"context"
+	"crypto/ecdh"
+	"crypto/rand"
+	"encoding/base64"
+	"errors"
+	"net"
+	"strconv"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/adapter"
+	"github.com/metacubex/mihomo/adapter/outbound"
+
+	"github.com/stretchr/testify/require"
+)
+
+// silentServer accepts TCP connections and never answers, like a server port
+// a provider filter has frozen.
+func silentServer(t *testing.T) (string, int) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	t.Cleanup(func() { listener.Close() })
+	go func() {
+		for {
+			conn, err := listener.Accept()
+			if err != nil {
+				return
+			}
+			go func() {
+				defer conn.Close()
+				_, _ = conn.Read(make([]byte, 4096))
+				time.Sleep(5 * time.Second)
+			}()
+		}
+	}()
+	host, port, _ := net.SplitHostPort(listener.Addr().String())
+	portNumber, _ := strconv.Atoi(port)
+	return host, portNumber
+}
+
+func TestURLTestReportsAStalledRealityHandshake(t *testing.T) {
+	key, err := ecdh.X25519().GenerateKey(rand.Reader)
+	require.NoError(t, err)
+	for name, network := range map[string]string{"tcp": "", "xhttp": "xhttp"} {
+		t.Run(name, func(t *testing.T) {
+			host, port := silentServer(t)
+			option := outbound.VlessOption{
+				Name:              "stall",
+				Server:            host,
+				Port:              port,
+				UUID:              "b831381d-6324-4d53-ad4f-8cda48b30811",
+				TLS:               true,
+				ServerName:        "www.example.com",
+				ClientFingerprint: "safari",
+				Network:           network,
+				RealityOpts: outbound.RealityOptions{
+					PublicKey:             base64.RawURLEncoding.EncodeToString(key.PublicKey().Bytes()),
+					SupportX25519MLKEM768: true,
+				},
+			}
+			if network == "xhttp" {
+				option.XHTTPOpts = outbound.XHTTPOptions{Path: "/", Mode: "auto"}
+			}
+			vless, err := outbound.NewVless(option)
+			require.NoError(t, err)
+			proxy := adapter.NewProxy(vless)
+
+			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+			defer cancel()
+			_, err = proxy.URLTest(ctx, "https://www.gstatic.com/generate_204", nil)
+
+			var stall interface{ HandshakeStalled() bool }
+			require.True(t, errors.As(err, &stall), "got %v", err)
+		})
+	}
+}
