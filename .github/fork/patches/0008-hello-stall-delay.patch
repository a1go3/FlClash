diff --git a/core/delay.go b/core/delay.go
index 41d69e0a..2b8081bb 100644
--- a/core/delay.go
+++ b/core/delay.go
@@ -2,6 +2,7 @@ package core
 
 import (
 	"context"
+	"errors"
 	"sync/atomic"
 	"time"
 
@@ -39,8 +40,9 @@ func currentTestURL() string {
 }
 
 const (
-	delayTimedOut int32 = -1
-	delayFailed   int32 = -2
+	delayTimedOut     int32 = -1
+	delayFailed       int32 = -2
+	delayHelloStalled int32 = -3
 )
 
 func delayValue(delay uint16, timedOut bool) int32 {
@@ -96,5 +98,15 @@ func handleTestDelay(params *TestDelayParams) *Delay {
 		delay = 0
 	}
 	result.Value = delayValue(delay, ctx.Err() != nil)
+	if isHelloStall(err) {
+		result.Value = delayHelloStalled
+	}
 	return result
 }
+
+// The fork's core patch marks a REALITY ClientHello that got no answer; matching
+// the method rather than the type keeps this building against a stock core.
+func isHelloStall(err error) bool {
+	var stall interface{ HandshakeStalled() bool }
+	return errors.As(err, &stall) && stall.HandshakeStalled()
+}
diff --git a/core/hub_test.go b/core/hub_test.go
index 95df0269..c2371288 100644
--- a/core/hub_test.go
+++ b/core/hub_test.go
@@ -265,6 +265,21 @@ func TestDelayValue(t *testing.T) {
 	}
 }
 
+type helloStallError struct{}
+
+func (helloStallError) Error() string { return "stalled" }
+
+func (helloStallError) HandshakeStalled() bool { return true }
+
+func TestIsHelloStall(t *testing.T) {
+	if !isHelloStall(fmt.Errorf("1.2.3.4:443 connect error: %w", helloStallError{})) {
+		t.Error("a wrapped stall is not recognised")
+	}
+	if isHelloStall(errors.New("connection refused")) || isHelloStall(nil) {
+		t.Error("an error without the stall method counts as a stall")
+	}
+}
+
