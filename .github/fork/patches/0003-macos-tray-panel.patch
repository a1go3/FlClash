+  static Rect? _decodeRect(Object? arguments) {
+    if (arguments is! Map) {
+      return null;
+    }
+    final values = [
+      arguments['x'],
+      arguments['y'],
+      arguments['width'],
+      arguments['height'],
+    ];
+    if (values.any((value) => value is! num)) {
+      return null;
+    }
+    final [x, y, width, height] = values.cast<num>();
+    return Rect.fromLTWH(
+      x.toDouble(),
+      y.toDouble(),
+      width.toDouble(),
+      height.toDouble(),
+    );
+  }
+
   /// Scales probed in Flutter's `2.0x/` variant layout; the README says how
   /// each platform consumes them.
