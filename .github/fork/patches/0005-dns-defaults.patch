From 1b778aac7670c2c4ef2e1be2a92dafeeac27e734 Mon Sep 17 00:00:00 2001
From: a1go3 <116062404+a1go3@users.noreply.github.com>
Date: Fri, 16 Oct 2026 23:58:03 +0300
Subject: [PATCH] feat(dns): resolve through Google and Yandex by default

A profile without a DNS section resolved through doh.pub and AliDNS, and mihomo bootstrapped those through Chinese resolvers, so the first visit to a site from Russia waited about 0.8 s instead of 0.2 s. The baseline now uses dns.google and Yandex DoH, bootstrapped through 77.88.8.8 and 8.8.8.8, and the macOS system DNS fallback is Yandex instead of AliDNS. A profile's own DNS section and the user's overrides are unchanged.

Changelog: Profiles without their own DNS settings resolve through Google and Yandex instead of Chinese servers
---
 lib/common/constant.dart                |  2 +-
 lib/models/clash_config.dart            | 10 +++++++++-
 test/common/task_dns_override_test.dart |  1 +
 test/models/dns_override_test.dart      |  1 +
 4 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/lib/common/constant.dart b/lib/common/constant.dart
index 401541e2..5904b420 100644
--- a/lib/common/constant.dart
+++ b/lib/common/constant.dart
@@ -129,3 +129,3 @@ const systemDnsRecordKey = 'system_dns_record';
 const bootRecordKey = 'boot_record';
-const defaultSystemDnsFallback = '223.5.5.5';
+const defaultSystemDnsFallback = '77.88.8.8';
 const double dialogCommonWidth = 300;
diff --git a/lib/models/clash_config.dart b/lib/models/clash_config.dart
index 3ef2110f..f9349d4d 100644
--- a/lib/models/clash_config.dart
+++ b/lib/models/clash_config.dart
@@ -24,4 +24,8 @@ const baselineDnsOverrideKeys = {
   DnsOverrideKey.enhancedMode,
+  DnsOverrideKey.defaultNameserver,
   DnsOverrideKey.nameserver,
 };
+
+/// The default nameservers only resolve the DoH hosts; mihomo's own defaults
+/// for them are Chinese resolvers, slow from where this fork is used.
 const baselineDns = Dns(
@@ -29,3 +33,7 @@ const baselineDns = Dns(
   enhancedMode: DnsMode.fakeIp,
-  nameserver: ['https://doh.pub/dns-query', 'https://dns.alidns.com/dns-query'],
+  defaultNameserver: ['77.88.8.8', '8.8.8.8'],
+  nameserver: [
+    'https://dns.google/dns-query',
+    'https://common.dot.dns.yandex.net/dns-query',
+  ],
 );
diff --git a/test/common/task_dns_override_test.dart b/test/common/task_dns_override_test.dart
index e24b340d..0476cb20 100644
--- a/test/common/task_dns_override_test.dart
+++ b/test/common/task_dns_override_test.dart
@@ -86,2 +86,3 @@ void main() {
         'enhanced-mode': 'fake-ip',
+        'default-nameserver': ['77.88.8.8', '8.8.8.8'],
         'nameserver': ['1.1.1.1'],
diff --git a/test/models/dns_override_test.dart b/test/models/dns_override_test.dart
index 76162e8e..db25ddc2 100644
--- a/test/models/dns_override_test.dart
+++ b/test/models/dns_override_test.dart
@@ -187,2 +187,3 @@ void main() {
         'enhanced-mode': 'fake-ip',
+        'default-nameserver': baselineDns.defaultNameserver,
         'nameserver': baselineDns.nameserver,
-- 
2.55.0

